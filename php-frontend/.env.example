# Copy to .env (or better: to ../ds-competition.env, one folder above public_html).
# Never commit the real file.

# Your FastAPI backend on Render (no slash at the end)
BACKEND_URL=https://your-backend.onrender.com

# Must be exactly the same as BACKEND_SECRET on the backend
BACKEND_SECRET=

# Optional: code participants must enter to join (tell them on the day). Empty = no code.
ACCESS_CODE=
