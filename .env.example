# Copy this file to .env and fill in your values. Never commit .env.

# Claude through your 9router proxy on Railway
CLAUDE_BASE_URL=https://your-9router.up.railway.app
CLAUDE_API_KEY=your-9router-key
CLAUDE_MODEL=cc/claude-opus-5

# Smart routing: which model does which job (names as listed in 9router)
CLAUDE_MODEL_FAST=cc/claude-haiku-4-5-20251001
CLAUDE_MODEL_CODE=cc/claude-opus-5-5
CLAUDE_MODEL_CHAT=cc/claude-sonnet-5-5
CLAUDE_MODEL_JUDGE=cc/claude-opus-5-5
# Backups, tried in order if a model fails
CLAUDE_FALLBACK_MODELS=cc/claude-opus-5-5,cc/claude-sonnet-5-5,cc/claude-opus-5

# E2B sandbox (https://e2b.dev > Dashboard > API Keys)
E2B_API_KEY=e2b_your_key

# Redis (local: redis://localhost:6379, Render fills this in for you)
REDIS_URL=redis://localhost:6379

CSV_PATH=data/messy_dataset.csv

# Security
# Long random string. The PHP UI's .env must have the same value.
# Make one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
BACKEND_SECRET=
ADMIN_KEY=
SHOW_DOCS=false
