# Copy this file to .env and fill in your values. Never commit .env.

# Claude through your 9router proxy on Railway
CLAUDE_BASE_URL=https://your-9router.up.railway.app
CLAUDE_API_KEY=your-9router-key
CLAUDE_MODEL=claude-opus-5-5

# E2B sandbox (https://e2b.dev > Dashboard > API Keys)
E2B_API_KEY=e2b_your_key

# Redis (local: redis://localhost:6379, Render fills this in for you)
REDIS_URL=redis://localhost:6379

CSV_PATH=data/messy_dataset.csv

# Security
# Long random string. The PHP UI's .env must have the same value.
# Make one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
BACKEND_SECRET=
ADMIN_KEY=
SHOW_DOCS=false
